root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 80
tab_width = 4
trim_trailing_whitespace = true

[*.yaml]
indent_size = 2

[*.rst]
indent_size = 3
max_line_length = 80

[Makefile]
indent_style = tab
trim_trailing_whitespace = false
